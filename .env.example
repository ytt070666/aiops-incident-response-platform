# 复制为 .env 后填写；绝对不要把 .env 上传到 GitHub。
# 可选值：deepseek、qwen、custom
LLM_PROVIDER=deepseek

# DeepSeek 示例
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# Qwen 示例：将 LLM_PROVIDER 改为 qwen，并填写 DASHSCOPE_API_KEY
# DASHSCOPE_API_KEY=
# LLM_MODEL=qwen-plus

# 自定义 OpenAI 兼容服务示例
# LLM_BASE_URL=https://your-provider/v1
# LLM_API_KEY=

# 完整 Docker 环境中默认指向 Java 告警服务；无需修改。
# ALERT_SERVICE_URL=http://alert-service:8081
